{
  "name": "vocabulary-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "api:validate": "node --test test/contract.test.mjs",
    "supabase:check": "node --env-file=.env.supabase.local scripts/check-supabase.mjs",
    "test:supabase": "npm run build && node --env-file=.env.supabase.local scripts/verify-supabase-auth.mjs",
    "test:supabase:sessions": "node --env-file=.env.supabase.local scripts/verify-supabase-sessions.mjs",
    "test:supabase:registration:begin": "npm run build && node --env-file=.env.supabase.local scripts/verify-supabase-registration.mjs --begin",
    "test:supabase:registration:complete": "node --env-file=.env.supabase.local scripts/verify-supabase-registration.mjs --complete",
    "benchmark:progress": "npm run build && node scripts/benchmark-progress.mjs",
    "test:postgres": "npm run build && node scripts/verify-local.mjs",
    "test:backup": "node scripts/check-backup-restore.mjs",
    "test:onboarding": "node scripts/check-onboarding.mjs",
    "benchmark:postgres": "npm run build && node scripts/benchmark-postgres.mjs",
    "test:ocr": "npm run build && node scripts/check-ocr-http.mjs",
    "benchmark:ocr": "npm run build && node scripts/check-ocr-http.mjs --benchmark",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:dev": "npm run build && npm start",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js test/*.test.mjs",
    "test:coverage": "npm run build && c8 node --test --test-concurrency=1 dist/test/*.test.js test/*.test.mjs && node scripts/check-coverage.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "jose": "^6.2.17",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "tinyld": "^1.3.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@electric-sql/pglite": "^0.3.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/swagger-ui-express": "^4.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "9.1.0",
    "typescript": "^5.9.0"
  }
}
