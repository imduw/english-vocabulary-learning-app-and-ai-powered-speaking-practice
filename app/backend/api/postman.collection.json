    {
      "name": "[implemented] registerAuth",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/register",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Public JSON endpoint. No query parameters or owner/provider/redirect fields. Passwords are hashed/salted by Supabase; no local password/refresh-token table. Requires SUPABASE_PUBLISHABLE_KEY; missing configuration returns 503. Shared 30 attempts/60 seconds/socket IP/process, ignoring forwarded IP headers. Refresh tokens are opaque and rotate under Supabase reuse/parent exceptions, not strict immediate rejection of every prior token. Sign-up may send confirmation email per project settings; no confirmation emails are sent by automated integration tests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"learner@example.com\",\n  \"password\": \"Example-only-passphrase!\"\n}",
          "options": {
            "raw": {
