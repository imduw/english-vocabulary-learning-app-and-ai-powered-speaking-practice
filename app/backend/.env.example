NODE_ENV=development
PORT=3000
# Local Docker only. Use a separate least-privilege role for application access.
DATABASE_URL=postgresql://cam_backend:local_backend_only@127.0.0.1:54329/vocabulary
MIGRATION_DATABASE_URL=postgresql://cam_migrator:local_migration_only@127.0.0.1:54329/vocabulary
DATABASE_SSL=false
DATABASE_POOL_MAX=5
DATABASE_TIMEOUT_MS=3000
# Direct Node uses WASM; Docker sets native (requires installed tesseract CLI).
OCR_ENGINE=wasm
OCR_WARMUP=true
# Exact Web app origins only; empty disables CORS. HTTPS required in production.
# CORS_ORIGINS=http://localhost:8080
# For remote certificates, set NODE_EXTRA_CA_CERTS to the trusted CA file.
# No Supabase service key or Gemini key is required for this foundation stage.
# Set your project origin to enable protected profile routes (never a token).
# SUPABASE_URL=https://your-project.supabase.co
# Auth register/login/refresh proxy only; never use secret/service_role here.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key
