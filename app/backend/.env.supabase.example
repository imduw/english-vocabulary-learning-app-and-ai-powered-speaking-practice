# Copy to .env.supabase.local and edit on your machine. Never commit credentials.
NODE_ENV=development
# 3000 is currently used by the local Docker backend.
PORT=3001
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Optional real Auth integration test credentials. Never commit real values.
TEST_A_EMAIL=cam-test-a@example.com
TEST_A_PASSWORD=
TEST_B_EMAIL=cam-test-b@example.com
TEST_B_PASSWORD=
DATABASE_SSL=true
DATABASE_CA_FILE=./supabase-ca.local.crt
DATABASE_POOL_MAX=3
DATABASE_TIMEOUT_MS=10000
# Copy the SESSION pooler URI from Supabase Connect. Replace the password locally.
# Percent-encode special characters in URI passwords. Remove sslmode parameters:
# TLS is configured through DATABASE_SSL, certificate verification stays enabled.
MIGRATION_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_DB_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
# Fill this AFTER provisioning a separate runtime role with vocabulary_api membership.
# Do not use the postgres/migration credential as DATABASE_URL.
DATABASE_URL=
# If needed, set NODE_EXTRA_CA_CERTS to Supabase's downloaded trusted CA file.
